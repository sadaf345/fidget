{
  "name": "fidget",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:tunnel": "expo start --tunnel",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "testflight": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "register-device": "npx eas-cli@latest device:create",
    "build:dev": "npx eas-cli@latest build --platform ios --profile development"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/jest": "29.5.14",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pulsar": "^1.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
